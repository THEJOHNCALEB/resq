# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Model files and captured media (never commit to version control)
*.task
*.bin
*.tflite
*.litertlm
*.m4a
*.jpg
*.jpeg
*.png
!**/assets/**/*.png
!**/res/**/*.png
gemma_model/

